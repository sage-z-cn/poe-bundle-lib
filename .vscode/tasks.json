{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tsc: build",
      "type": "typescript",
      "tsconfig": "tsconfig.json",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "dependsOn": []
    },
    {
      "label": "npm: clean",
      "type": "npm",
      "script": "clean",
      "problemMatcher": []
    },
    {
      "label": "npm: release",
      "type": "npm",
      "script": "release",
      "group": "none",
      "problemMatcher": ["$tsc"],
      "dependsOn": ["npm: build"]
    },
    {
      "label": "Build & Release",
      "dependsOrder": "sequence",
      "dependsOn": ["npm: clean", "npm: release"],
      "problemMatcher": []
    }
  ]
}
